# Copy to .env.local for development. Real values live in Vercel env vars.
# Anything without NEXT_PUBLIC_ is server-only and must never reach the browser.

APP_BASE_URL=https://joeweisman.org

# Neon (Postgres) — server only
DATABASE_URL=

# Cloudflare R2 — server only
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Cloudflare Images — server only
CF_IMAGES_ACCOUNT_ID=
CF_IMAGES_API_TOKEN=
NEXT_PUBLIC_CF_IMAGES_HASH=       # public delivery hash, safe in browser

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=   # public by design
TURNSTILE_SECRET_KEY=             # server only

# Resend — admin notifications only, not the list
RESEND_API_KEY=
ADMIN_NOTIFY_TO=joeweismanmemorial@gmail.com

# Admin page — one long random string, server only
ADMIN_PASSWORD=

# Salt for hashing submitter IPs. Random, server only, never rotate casually.
IP_HASH_SALT=
